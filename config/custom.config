# ============================================================
# 完整 .config 由 build_step2.sh + build_step3.sh 自动生成
# （基础部分来自 Kwrt 仓库 devices/common/.config 与
#  devices/qualcommax_ipq807x/.config，克隆后即存在）。
# 本文件仅保存与上游不同的自定义增量，供核对。
# ============================================================

# --- 自定义 v1: 只编译 Redmi AX6 + 关键应用（build_step2.sh 追加） ---
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-gpsysupgrade=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-oui=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-vantage=y

# --- 自定义 v2: argon 主题 + 移除 odhcpd(ipv6)（build_step3.sh 追加） ---
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_DEFAULT_odhcpd-ipv6only=n
CONFIG_PACKAGE_odhcpd-ipv6only=n

# --- 无线驱动段 =m → =n（build_step2.sh 自动执行 sed，节省体积） ---
#   最终保留：kmod-ath11k=y、kmod-ath11k-ahb=y、kmod-ath=y、kmod-mac80211=y、
#   kmod-cfg80211=y、CONFIG_ATH_USER_REGD=y、CONFIG_PACKAGE_ATH_DFS=y
#   其余无线驱动（mt76/brcmfmac/iwlwifi 等）全部关闭

# --- 编译注意事项 ---
# 1) devices/common/.config 与 qualcommax_ipq807x/.config 拼接前，
#    需在 cp 与 cat 之间执行 echo >> .config 补换行（否则末尾配置被吞，目标丢失）。
# 2) 缺失 LLVM opt 时 qosify 会编译失败（=m 不进镜像），已禁用：
#    CONFIG_PACKAGE_qosify=n
# 3) diy.sh 依赖 git_clone_path 函数与 jq，按 scripts/fix_diy.sh 修复。
# 4) FORCE_UNSAFE_CONFIGURE=1 为以 root 编译所需。
